# Copy to .env.local for development. On Vercel, set these under
# Project → Settings → Environment Variables. See docs/CONTACT_FORM_SETUP.md.

# Resend → API Keys. Required for both contact forms to send anything.
RESEND_API_KEY=

# Where inquiries are delivered. Comma-separate several addresses.
# Until the domain is verified in Resend, this must be the email that owns
# the Resend account.
CONTACT_TO=volodumer2005@gmail.com

# Sender shown in the inbox. Leave unset to use Resend's shared test sender.
# After the domain is verified: CONTACT_FROM="SKLO Studio <inquiries@sklo.studio>"
CONTACT_FROM=

# Vercel → Storage → Blob → .env.local tab. Required for file attachments.
# Without it the forms still send, the file picker is just disabled.
BLOB_READ_WRITE_TOKEN=

# Canonical origin for metadata, sitemap and robots. Leave unset for sklo.studio.
# NEXT_PUBLIC_SITE_URL=https://sklo.studio
